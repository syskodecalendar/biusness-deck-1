PORT=4000
CLIENT_URL=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY is optional in v2.0.1 because protected API auth is
# validated with the server-side service-role client.
SUPABASE_ANON_KEY=
# Recommended new server key (Supabase Settings → API Keys → Secret keys)
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_SECRET
# Legacy alternative; leave blank if using SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=business-documents
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:4000/api/zoho/callback
ZOHO_ORGANIZATION_ID=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_BASE=https://www.zohoapis.com/books/v3
ZOHO_WEBHOOK_SECRET=
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret
